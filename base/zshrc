export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)
source "$ZSH/oh-my-zsh.sh"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

[ -f "$HOME/.keyring-env" ] && source "$HOME/.keyring-env"

export PATH="/usr/local/bin:$HOME/.local/bin:$PATH"
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

if [[ $- == *i* ]] && command -v gh >/dev/null 2>&1; then
  gh auth status >/dev/null 2>&1 || \
    echo "GitHub not authenticated. Run: gh auth login"
fi

CAPSULE_LABEL="${CAPSULE_NAME:-$HOST}"

DISABLE_AUTO_TITLE=true

_capsule_set_title() {
  local cwd="${PWD/#$HOME/~}"
  printf '\033]2;[capsule:%s] %s\007' "${CAPSULE_LABEL}" "${cwd}"
  printf '\033]1;[capsule:%s] %s\007' "${CAPSULE_LABEL}" "${cwd}"
}

_capsule_clear_title() {
  printf '\033]2;\007'
  printf '\033]1;\007'
}

_capsule_profile_enabled() {
  [[ "${CAPSULE_ITERM_PROFILE_SWITCH:-1}" != "0" ]]
}

if [[ -o interactive ]]; then
  if _capsule_profile_enabled; then
    printf '\033]1337;SetProfile=%s\007' "${ITERM_DEVCONTAINER_PROFILE:-fenix-devcontainer}"
  fi

  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _capsule_set_title
  add-zsh-hook chpwd _capsule_set_title
  _capsule_set_title

  print -P "%F{cyan}capsule%f: %F{green}${CAPSULE_LABEL}%f"
  [[ -n "${CAPSULE_INFO:-}" ]] && print -P "%F{8}${CAPSULE_INFO}%f"

  if [[ -f "$HOME/.capsule-welcome" ]]; then
    cat -- "$HOME/.capsule-welcome"
  elif [[ -n "${CAPSULE_WELCOME:-}" ]]; then
    print -r -- "${CAPSULE_WELCOME}"
  fi

  _capsule_on_exit() {
    _capsule_clear_title
    if _capsule_profile_enabled; then
      printf '\033]1337;SetProfile=%s\007' "${ITERM_DEFAULT_PROFILE:-fenix}"
    fi
  }
  add-zsh-hook zshexit _capsule_on_exit
fi
