export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)
source "$ZSH/oh-my-zsh.sh"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

if [[ -o interactive ]] && [[ -t 0 ]] && [[ "${CAPSULE_KEYRING_PROMPT:-1}" != "0" ]] \
  && command -v capsule-unlock >/dev/null 2>&1 && ! capsule-unlock --status >/dev/null 2>&1; then
  capsule-unlock
fi

[ -f "$HOME/.keyring-env" ] && source "$HOME/.keyring-env"

export PATH="/usr/local/bin:$HOME/.local/bin:$PATH"
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

if [[ $- == *i* ]] && command -v gh >/dev/null 2>&1; then
  gh auth status >/dev/null 2>&1 || \
    echo "GitHub not authenticated. Run: gh auth login"
fi

if [[ $- == *i* ]] && grep -qs 'mise=untrusted' "$HOME/.provisioned/status"; then
  echo "mise.toml not trusted; tools not installed. Review ~/mise.toml, then run: mise trust ~/mise.toml && provision.sh"
fi

CAPSULE_LABEL="${CAPSULE_NAME:-$HOST}"

DISABLE_AUTO_TITLE=true

_capsule_set_title() {
  local cwd="${PWD/#$HOME/~}"
  printf '\033]2;[capsule:%s] %s\007' "${CAPSULE_LABEL}" "${cwd}"
  printf '\033]1;[capsule:%s] %s\007' "${CAPSULE_LABEL}" "${cwd}"
}

_capsule_clear_title() {
  printf '\033]2;\007'
  printf '\033]1;\007'
}

_capsule_profile_enabled() {
  [[ "${CAPSULE_ITERM_PROFILE_SWITCH:-1}" != "0" ]]
}

_capsule_colors_enabled() {
  [[ "${CAPSULE_TERM_COLORS:-${CAPSULE_ITERM_PROFILE_SWITCH:-1}}" != "0" ]]
}

_capsule_set_colors() {
  local -a ansi=(
    21222c ff5555 50fa7b f1fa8c bd93f9 ff79c6 8be9fd f8f8f2
    6272a4 ff6e6e 69ff94 ffffa5 d6acff ff92df a4ffff ffffff
  )
  local i
  for i in {1..16}; do
    printf '\033]4;%d;#%s\007' $((i - 1)) "${ansi[i]}"
  done
  printf '\033]10;#f8f8f2\007\033]11;#282a36\007\033]12;#f8f8f2\007'
  printf '\033]17;#44475a\007\033]19;#f8f8f2\007'
}

_capsule_reset_colors() {
  printf '\033]104\007\033]110\007\033]111\007\033]112\007\033]117\007\033]119\007'
}

if [[ -o interactive ]]; then
  if _capsule_profile_enabled; then
    printf '\033]1337;SetProfile=%s\007' "${ITERM_DEVCONTAINER_PROFILE:-fenix-devcontainer}"
  fi
  if _capsule_colors_enabled; then
    _capsule_set_colors
  fi

  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _capsule_set_title
  add-zsh-hook chpwd _capsule_set_title
  _capsule_set_title

  print -P "%F{cyan}capsule%f: %F{green}${CAPSULE_LABEL}%f"
  [[ -n "${CAPSULE_INFO:-}" ]] && print -P "%F{8}${CAPSULE_INFO}%f"

  if [[ -f "$HOME/.capsule-welcome" ]]; then
    tr -d '\000-\010\013-\037\177' <"$HOME/.capsule-welcome"
  elif [[ -n "${CAPSULE_WELCOME:-}" ]]; then
    print -r -- "${CAPSULE_WELCOME}" | tr -d '\000-\010\013-\037\177'
  fi

  _capsule_on_exit() {
    _capsule_clear_title
    if _capsule_colors_enabled; then
      _capsule_reset_colors
    fi
    if _capsule_profile_enabled; then
      printf '\033]1337;SetProfile=%s\007' "${ITERM_DEFAULT_PROFILE:-fenix}"
    fi
  }
  add-zsh-hook zshexit _capsule_on_exit
fi
